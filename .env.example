# Datos exclusivamente locales y ficticios. No reutilizar en despliegues.
DATABASE_URL=postgresql://gps:gps_local@localhost:5432/lost_found
TEST_DATABASE_URL=postgresql://gps:gps_local@localhost:5432/lost_found_test
PORT=3000
SMTP_TEST_PORT=1025
# Cambiar a http://localhost:3000 al probar el monolito compilado.
RECOVERY_APP_ORIGIN=http://localhost:5173
# Firma de la cookie de sesión (US-002). Obligatoria, mínimo 32 caracteres.
# Generar uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-valor-local-por-uno-aleatorio-de-64-caracteres
